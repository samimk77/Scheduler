// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  googleId      String   @unique
  email         String   @unique
  name          String
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slackToken    String?  @db.Text
  slackTeamId   String?
  slackChannelId String?
  slackWebhookUrl String? @db.Text

  emailJobs     EmailJob[]
  senders       Sender[]

  @@map("users")
}

model Sender {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String
  host      String
  port      Int      @default(587)
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@unique([userId, email])
  @@map("senders")
}

model EmailJob {
  id             String      @id @default(uuid())
  userId         String
  senderId       String
  recipients     Json        // Array of email addresses
  subject        String      @db.Text
  body           String      @db.LongText
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(SCHEDULED)
  bullJobId      String?     @unique
  errorMessage   String?     @db.Text
  idempotencyKey String      @unique
  hourlyLimit    Int         @default(50)
  delayBetweenMs Int         @default(2000)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@map("email_jobs")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}
